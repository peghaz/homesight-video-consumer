# Run from the repository root; Sphinx invokes this automatically.
PROJECT_NAME           = "HomeSight Core"
PROJECT_NUMBER         = $(HOMESIGHT_DOCS_VERSION)
OUTPUT_DIRECTORY       = build/docs/doxygen
INPUT                  = include/homesight
FILE_PATTERNS          = *.hpp
RECURSIVE              = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = include
GENERATE_HTML          = YES
GENERATE_XML           = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
WARN_LOGFILE           = build/docs/doxygen-warnings.log
XML_PROGRAMLISTING     = NO
SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO
