# Test settings only. The native library receives its configuration from the application.

# RTSP camera URL used by live recording tests.
TEST_RTSP_URL=

# Path to a short real camera recording for sampling and the S3 file roundtrip test.
TEST_SEGMENT=

# Path to chronological recordings and motion labels in JSON.
TEST_DATASET_MANIFEST=

# Recording time for each live camera test, in seconds.
TEST_CAMERA_TEST_SECONDS=25

# URL of the real S3-compatible endpoint used by storage tests.
TEST_S3_ENDPOINT=

# Existing bucket for isolated test objects.
TEST_S3_BUCKET=

# Access key for the S3 test bucket.
TEST_S3_ACCESS_KEY=

# Secret key for the S3 test bucket.
TEST_S3_SECRET_KEY=

# Optional session token for temporary S3 test credentials.
TEST_S3_SESSION_TOKEN=

# Actual H.264/H.265 replay source of at least 30 seconds for owned RTSP fault tests.
TEST_REPLAY_SEGMENT=

# Actual footage for the codec/container matrix (each at least 12 seconds).
TEST_H264_SEGMENT=
TEST_H265_SEGMENT=

# System Python with PyGObject and the GstRtspServer typelib; separate from uv's Python.
TEST_RTSP_PYTHON=/usr/bin/python3

# Cached real MinIO image used only by ephemeral pytest-owned containers.
TEST_MINIO_IMAGE=pgsty/silo:RELEASE.2026-11-12T00-00-00Z

# Dedicated-process resource measurement duration; minimum five minutes.
TEST_MEASUREMENT_SECONDS=300

# Optional private directory of TSan-instrumented native dependencies (native children only).
TEST_TSAN_LIBRARY_PATH=
